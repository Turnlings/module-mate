- cache [academic_entity, current_user] do
  .flex-col.align-left{ data: { controller: "toggle" } }
    .score-section.w-100
      .main 
        %h3 ACHIEVED
        .flex-row.space-between
          - achieved_score = academic_entity.achieved_score(current_user)
          - if achieved_score.nil?
            .stat= "N/A"
          - else
            .stat= number_to_percentage(achieved_score, precision: 1)
          - if academic_entity.is_a?(Exam)
            = link_to edit_exam_result_path(@exam), class: 'icon-button record-score-button', title: "Edit #{@exam.name} Score" do
              %i.fa-solid.fa-pen-to-square
              %span Record Score
      .items
        - if academic_entity.is_a?(Year) || academic_entity.is_a?(Exam)
          .item 
            %h3 WEIGHTING
            .stat= number_to_percentage(academic_entity.weighting, precision: 0)
        - else
          .item 
            %h3 CREDITS
            .stat= number_with_precision(academic_entity.credits, precision: 0)
        - if not academic_entity.is_a?(Exam) && academic_entity.progress(current_user) > 0
          .item 
            %h3 ON TRACK
            .stat= classification(academic_entity.predicted_score(current_user))
        
        - if not academic_entity.is_a?(Exam)
          .right.button-row 
            %button.icon-button.h-100{ data: { action: "click->toggle#toggle", toggle_target: "button" } }
              %i.fa-solid.fa-angle-down
              %span More Stats
    
    - if not academic_entity.is_a?(Exam)
      .stats-container.w-100{ data: { toggle_target: "content" }, hidden: true }
        .stat 
          .stat-header 
            = link_to edit_uni_module_path(academic_entity, anchor: 'final_score') do
              Achieved Score
          .stat-content= number_to_percentage(academic_entity.achieved_score(current_user), precision: 2)
        .stat 
          .stat-header Predicted Score
          .stat-content= number_to_percentage(academic_entity.predicted_score(current_user), precision: 2)
        - if academic_entity.respond_to?(:completion_percentage)
          .stat 
            .stat-header Completion
            .stat-content= number_to_percentage(academic_entity.completion_percentage(current_user), precision: 2)
        .stat 
          .stat-header Credits Completed
          .stat-content= number_with_precision(academic_entity.completed_credits(current_user), precision: 2)
        .stat 
          .stat-header Weighting
          .stat-content= number_to_percentage(academic_entity.weight, precision: 3)

    .body.w-100{ data: { react_component: "SegmentedBar", props: { data: segmented_bar_data }.to_json} }