.page-heading  
  %nav
    %ol.breadcrumb
      %li.breadcrumb-item= link_to @semester.year.name, @semester.year
      %li.breadcrumb-item= link_to @semester.name, @semester 
      %li.breadcrumb-item.active= @uni_module.name
  .button-row
    = button_to pin_uni_module_path(@uni_module), method: :patch, class: (@uni_module.pinned? ? 'icon-button' : 'icon-button unselected'), title: (@uni_module.pinned? ? 'Unpin module' : 'Pin module') do
      - if @uni_module.pinned?
        %i.fa-solid.fa-thumbtack
        %span Unpin
      - else
        %i.fa-solid.fa-thumbtack
        %span Pin
    = link_to edit_uni_module_path(@uni_module), class: 'icon-button' do
      %i.fa-solid.fa-pen-to-square
      %span Edit

.flex-col.align-left{ data: { controller: "toggle" } }
  .score-section.w-100
    .main 
      %h3 ACHIEVED
      .stat= number_to_percentage(@uni_module.achieved_score(current_user), precision: 1)
    .items
      .item 
        %h3 CREDITS
        .stat= number_with_precision(@uni_module.credits, precision: 0)
      .item 
        %h3 ON TRACK
        .stat= classification(@uni_module.predicted_score(current_user))
      .right.button-row 
        %button.icon-button.h-100{ data: { action: "click->toggle#toggle", toggle_target: "button" } }
          %i.fa-solid.fa-angle-down
          %span More Stats
  
  .stats-container.w-100{ data: { toggle_target: "content" }, hidden: true }
    .stat 
      .stat-header 
        = link_to edit_uni_module_path(@uni_module, anchor: 'final_score') do
          Achieved Score
      .stat-content= number_to_percentage(@uni_module.achieved_score(current_user), precision: 2)
    .stat 
      .stat-header Predicted Score
      .stat-content= number_to_percentage(@uni_module.predicted_score(current_user), precision: 2)

  .body.w-100{ data: { react_component: "SegmentedBar"} }

.exams-container
  .exams 
    .gt-empty-card
      = render 'exams'
  .graph-split
    .gt-empty-card
      .heading
        %h2 Assessment Split
      .body
        .chart-container
          = pie_chart @exam_data, legend: false, width: "100%", library: { aspectRatio: "1|1" }, id: 'exam-chart'

-# Graph
= turbo_frame_tag "uni_module_time_chart" do
  = render partial: 'shared/time_chart', locals: { subject: @uni_module, time_path: -> { time_module_path(id: @uni_module.id, cumulative: params[:cumulative], date_since: params[:date_since]) }, date_since: params[:date_since], form_url: uni_module_path(@uni_module), turbo_frame_id: "uni_module_time_chart" }
      
.row
  .col
    = render 'timelogs'