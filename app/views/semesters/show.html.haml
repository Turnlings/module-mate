.page-heading
  %nav
    %ol.breadcrumb
      %li.breadcrumb-item= link_to @semester.year.name, @semester.year
      %li.breadcrumb-item.active= @semester.name
  .button-row
    = link_to share_semester_url(@semester.share_token), class: 'icon-button', title: 'Share Template' do
      %i.fa-solid.fa-share
      %span Share
    = link_to edit_semester_path(@semester), class: 'icon-button' do
      %i.fa-solid.fa-pen-to-square
      %span Edit

.flex-col.align-left{ data: { controller: "toggle" } }
  .score-section.w-100
    .main 
      %h3 ACHIEVED
      .stat= number_to_percentage(@semester.achieved_score(current_user), precision: 1)
    .items
      .item 
        %h3 CREDITS
        .stat= number_with_precision(@semester.credits, precision: 0)
      .item 
        %h3 ON TRACK
        .stat= classification(@semester.predicted_score(current_user))
      .right.button-row 
        %button.icon-button.h-100{ data: { action: "click->toggle#toggle", toggle_target: "button" } }
          %i.fa-solid.fa-angle-down
          %span More Stats
  
  .stats-container.w-100{ data: { toggle_target: "content" }, hidden: true }
    .stat 
      .stat-header Average Score
      .stat-content= number_to_percentage(@semester.average_score(current_user), precision: 2)
    .stat 
      .stat-header 
        = link_to edit_semester_path(@semester, anchor: 'final_score') do
          Achieved Score
      .stat-content= number_to_percentage(@semester.achieved_score(current_user), precision: 2)

  .body.w-100{ data: { react_component: "SegmentedBar", props: { data: @segmented_bar_data }.to_json} }

= turbo_frame_tag "modules" do
  .gt-empty-card
    .heading
      %h2 Modules

      = link_to new_uni_module_path(semester_id: @semester.id), class: 'icon-button light', title: 'Add New Module' do
        %i.fa-solid.fa-plus
        %span Add
    .body
      .link-cards-list
        - @uni_modules.each do |uni_module|
          = render partial: 'shared/module_card', locals: { uni_module: uni_module }

-# Graph
= turbo_frame_tag "semester_time_chart" do
  = render partial: 'shared/time_chart', locals: { subject: @semester, time_path: -> { time_semester_path(id: @semester.id, cumulative: params[:cumulative], date_since: params[:date_since]) }, date_since: params[:date_since], form_url: semester_path(@semester), turbo_frame_id: "semester_time_chart" }